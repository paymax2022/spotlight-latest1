# Admin dashboard — production env template. Copy to .env.production (or set in the
# host environment) and fill in real values. In production every admin console
# should hit the live Go backend, so all *_USE_MOCK flags default to false here.

# ── Core ─────────────────────────────────────────────────────────────────────
# Go financial backend base. Each admin service derives its admin base from this
# by swapping the trailing /api/v1 for the module's admin prefix.
NEXT_PUBLIC_ADMIN_API_BASE_URL=https://api.example.com/api/v1

# Supabase (admin auth / SSR).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── New module admin consoles (live backend in production → mock off) ─────────
# Telemedicine: read-only oversight — backend has NO admin route group; reads
# /api/v1/telemedicine/* (specialties / doctors / appointments).
NEXT_PUBLIC_TELEMEDICINE_ADMIN_USE_MOCK=false

# Groups: read-only oversight — backend has NO admin route group; reads
# /api/finance/groups (list / get / members).
# Groups (savings pools) has no admin backend yet — 'false' pointed this console
# at endpoints that do not exist (404s), it did not make the data real. Kept
# explicitly on mock, allowlisted in scripts/check-mock-flags.mjs, and the pages
# render a visible "SAMPLE DATA" banner. Flip to false and delete the allowlist
# entry when a groups admin route group ships.
NEXT_PUBLIC_GROUPS_ADMIN_USE_MOCK=true

# Associations: real admin surface at /api/finance/associations/admin/*
# (KPIs, approvals, finance + offline-payment review, member ops, CSV import).
NEXT_PUBLIC_ASSOCIATION_ADMIN_USE_MOCK=false

# P2P Marketplace: thin admin surface — arbitration at
# /api/p2p/admin/p2p/orders/:id/arbitrate (RBAC p2p.dispute.arbitrate);
# listings/orders read from /api/finance/p2p/*.
NEXT_PUBLIC_P2PMARKET_ADMIN_USE_MOCK=false

# Spray: thin admin surface — leaderboard at
# /api/spray/admin/spray/leaderboard/:contextRef (RBAC spray.read).
# Payouts have no backend admin route (that view stays mock regardless).
NEXT_PUBLIC_SPRAY_ADMIN_USE_MOCK=false

# Points: thin admin surface via the loyalty admin group — membership lookup at
# /api/loyalty/admin/loyalty/memberships/:userId (RBAC loyalty.read).
# The points ledger has no backend list route (that view stays mock regardless).
NEXT_PUBLIC_POINTS_ADMIN_USE_MOCK=false

# Health consoles (pharmacy incl. symptom-search reviews/mappings, lab, vet):
# live at /api/health/<vertical>/admin/* — RBAC health.* per route. Symptom
# go-live runbook: docs/health/PHARMACY_SYMPTOM_SEARCH_GOLIVE.md.
NEXT_PUBLIC_HEALTH_USE_MOCK=false
