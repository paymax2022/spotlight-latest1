# Admin dashboard env template — copy to .env.local and fill in.

# Go financial backend base. Admin services derive the transport admin base from
# this by swapping the trailing /api/v1 for /api/finance/admin/transport.
NEXT_PUBLIC_ADMIN_API_BASE_URL=http://localhost:8080/api/v1

# Mobility admin data source: 'false' calls the live Go backend
# (/api/finance/admin/transport/*). Anything else (or unset) uses mock data so the
# console renders with no backend. Backend needs FEATURE_TRANSPORT_ENABLED=true,
# and ADMIN_API_KEY must match (sent as x-admin-api-key) when set on the backend.
NEXT_PUBLIC_MOBILITY_ADMIN_USE_MOCK=true

# Multi-mode admin views (parcels, bus, towing, movers, car hire). 'false' calls
# the live Go backend (/api/finance/admin/transport/{parcels,bus,...}).
NEXT_PUBLIC_MOBILITY_MODES_USE_MOCK=true

# Realtor admin console (overview, listing moderation, verification, payments/escrow).
# 'false' calls the live realtor admin endpoints (/api/realtor/admin/...).
NEXT_PUBLIC_REALTOR_ADMIN_USE_MOCK=true

NEXT_PUBLIC_ONBOARDING_ADMIN_USE_MOCK=false   # set true to render with fixtures (no backend needed)

# Featured Placement admin review queue. 'false' calls the live Go backend
# (/api/placement/admin/*). Anything else (or unset) uses fixtures so the
# console renders standalone with no backend.
NEXT_PUBLIC_FEATURED_PLACEMENT_ADMIN_USE_MOCK=true

# Nutrition admin console (composition reference, Nigerian Dish Library,
# implausible-values review). 'false' calls the live Go backend
# (/api/nutrition/admin/*). Anything else (or unset) uses fixtures.
NEXT_PUBLIC_NUTRITION_ADMIN_USE_MOCK=true

# Pre-Consultation Intake admin console (form builder, red-flag rules, consent,
# vocab, config, monitoring, record viewer, access log, red-flag queue, analytics).
# 'false' calls the live Go backend (/api/health/admin/intake/*). Anything else
# (or unset) uses fixtures so the console renders standalone with no backend.
NEXT_PUBLIC_INTAKE_ADMIN_USE_MOCK=true

# Delivery-fee admin console (restaurant delivery-fee formula config: base,
# distance, time, surge, surcharges, promo, ETA/road, floor/cap). 'false' calls
# the live Go backend (/api/restaurant/admin/delivery-config, RBAC
# restaurant.admin.pricing). Anything else (or unset) uses fixtures so the
# console renders standalone with no backend.
NEXT_PUBLIC_DELIVERY_FEE_ADMIN_USE_MOCK=true

# Transfers admin console (outbound transfers across Paystack/Monnify, provider
# health, retry/reverse). 'false' calls the live Go backend
# (/api/finance/admin/transfers/*, RBAC finance.admin.transfers). Anything else
# (or unset) uses fixtures so the console renders standalone with no backend.
NEXT_PUBLIC_TRANSFERS_ADMIN_USE_MOCK=true
