# =============================================================================
# Paymax x Spotlight Super App — PRODUCTION env TEMPLATE
# =============================================================================
# Copy to `.env.production` and fill the CHANGE_ME placeholders before building.
#   cp .env.production.example .env.production
#
# All EXPO_PUBLIC_* values are inlined into the bundle at build time and are
# PUBLIC — never put secrets here. Each `*_USE_MOCK` flag defaults to MOCK when
# missing, so it MUST be exactly "false" to go live.
#
# Guard: `node scripts/check-estate-mocks.mjs .env.production` fails the build if
# any estate flag is missing or not exactly "false".
# Full reference: docs/GO-LIVE-CONFIG.md
# =============================================================================

# ── Core ─────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_BASE_URL=https://CHANGE_ME.example.com
EXPO_PUBLIC_APP_ENV=production
# EXPO_PUBLIC_MAPS_BASE_URL=https://CHANGE_ME.example.com/api/finance/maps
EXPO_PUBLIC_SUPABASE_URL=https://CHANGE_ME.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_CHANGE_ME
EXPO_PUBLIC_PASSWORD_RESET_REDIRECT_URL=https://CHANGE_ME.example.com/login
# Fallback only — address capture prefers the MapService proxy above. Optional.

# ── Finance / Wallet ─────────────────────────────────────────────────────────
EXPO_PUBLIC_FX_USE_MOCK=false
EXPO_PUBLIC_SAVINGS_USE_MOCK=false
EXPO_PUBLIC_SOCIAL_USE_MOCK=false
EXPO_PUBLIC_LOYALTY_USE_MOCK=false
EXPO_PUBLIC_REFERRAL_USE_MOCK=false
EXPO_PUBLIC_INSURANCE_USE_MOCK=false

# ── Investment ───────────────────────────────────────────────────────────────
EXPO_PUBLIC_INVEST_USE_MOCK=false
EXPO_PUBLIC_STOCKS_USE_MOCK=false
EXPO_PUBLIC_ONBOARDING_USE_MOCK=false
EXPO_PUBLIC_SETTINGS_USE_MOCK=false
EXPO_PUBLIC_AI_USE_MOCK=false
EXPO_PUBLIC_LEARN_USE_MOCK=false
EXPO_PUBLIC_ACADEMY_USE_MOCK=false
EXPO_PUBLIC_SPOTLIGHT_USE_MOCK=false
EXPO_PUBLIC_FRACTIONALRE_USE_MOCK=false
# Crypto requires backend FEATURE_CRYPTO_ENABLED=true to actually serve live.
EXPO_PUBLIC_CRYPTO_USE_MOCK=false

# ── Health ───────────────────────────────────────────────────────────────────
EXPO_PUBLIC_HEALTH_USE_MOCK=false
EXPO_PUBLIC_DOCTOR_USE_MOCK=false
# Pharmacy symptom-based search UI gate (defaults ON; must be exactly "true").
# Requires backend FEATURE_PHARMACY_SYMPTOM_SEARCH_ENABLED=true (AND health +
# pharmacy flags) — see docs/health/PHARMACY_SYMPTOM_SEARCH_GOLIVE.md.
EXPO_PUBLIC_HEALTH_PHARMACY_SYMPTOM_SEARCH=true

# ── Mobility (transport) ─────────────────────────────────────────────────────
# Requires backend FEATURE_TRANSPORT_ENABLED + FEATURE_TRANSPORT_MODES_ENABLED.
EXPO_PUBLIC_MOBILITY_USE_MOCK=false
EXPO_PUBLIC_PARCEL_USE_MOCK=false
EXPO_PUBLIC_BUS_USE_MOCK=false
EXPO_PUBLIC_TOWING_USE_MOCK=false
EXPO_PUBLIC_MOVERS_USE_MOCK=false
EXPO_PUBLIC_CARHIRE_USE_MOCK=false
EXPO_PUBLIC_LOGISTICS_USE_MOCK=false
EXPO_PUBLIC_EVENT_USE_MOCK=false

# ── Commerce ─────────────────────────────────────────────────────────────────
EXPO_PUBLIC_FOOD_USE_MOCK=false
EXPO_PUBLIC_RESTAURANT_USE_MOCK=false
EXPO_PUBLIC_MERCHANT_USE_MOCK=false

# ── Social / Community ───────────────────────────────────────────────────────
EXPO_PUBLIC_CONNECT_USE_MOCK=false
EXPO_PUBLIC_CREATORS_USE_MOCK=false
EXPO_PUBLIC_EVENTS_USE_MOCK=false
EXPO_PUBLIC_ASSOCIATION_USE_MOCK=false
EXPO_PUBLIC_CF_USE_MOCK=false
EXPO_PUBLIC_VOTING_USE_MOCK=false

# ── Property ─────────────────────────────────────────────────────────────────
EXPO_PUBLIC_PROPERTY_USE_MOCK=false
EXPO_PUBLIC_PROPERTIES_USE_MOCK=false
EXPO_PUBLIC_REALTOR_USE_MOCK=false
EXPO_PUBLIC_STAYS_USE_MOCK=false

# ── Estate (Blocks 29–46) — all required false by check-estate-mocks.mjs ──────
EXPO_PUBLIC_DUES_USE_MOCK=false
EXPO_PUBLIC_MEETINGS_USE_MOCK=false
EXPO_PUBLIC_TASKS_USE_MOCK=false
EXPO_PUBLIC_REPAIRS_USE_MOCK=false
EXPO_PUBLIC_FACILITIES_USE_MOCK=false
EXPO_PUBLIC_ANNOUNCEMENTS_USE_MOCK=false
EXPO_PUBLIC_EMERGENCIES_USE_MOCK=false
EXPO_PUBLIC_DOCUMENTS_USE_MOCK=false
EXPO_PUBLIC_VENDORS_USE_MOCK=false
EXPO_PUBLIC_AINOTES_USE_MOCK=false
EXPO_PUBLIC_FINANCE_USE_MOCK=false
EXPO_PUBLIC_ESTATEADMIN_USE_MOCK=false
EXPO_PUBLIC_NOTIFICATIONS_USE_MOCK=false
EXPO_PUBLIC_REPORTS_USE_MOCK=false
EXPO_PUBLIC_ESTATESETTINGS_USE_MOCK=false

# ── Estate / Visitor access ──────────────────────────────────────────────────
EXPO_PUBLIC_VISITOR_USE_MOCK=false
EXPO_PUBLIC_ELECTION_USE_MOCK=false

# ── Admin / Registration ─────────────────────────────────────────────────────
EXPO_PUBLIC_ADMIN_USE_MOCK=false
EXPO_PUBLIC_REGISTRATION_USE_MOCK=false

# ── Flags that were referenced in code but never listed here ─────────────────
# Added by the check-env-mocks audit. Every one of these defaults to MOCK when
# absent, so until now a production build served fake data for all of them —
# including KYC verification results and the transfers money path.
EXPO_PUBLIC_TRANSFERS_USE_MOCK=false
EXPO_PUBLIC_KYC_VERIFY_USE_MOCK=false
EXPO_PUBLIC_TELEMEDICINE_USE_MOCK=false
EXPO_PUBLIC_MARKETPLACE_USE_MOCK=false
EXPO_PUBLIC_TRADING_USE_MOCK=false
EXPO_PUBLIC_ARENA_USE_MOCK=false
EXPO_PUBLIC_ACADEMY_FEES_USE_MOCK=false
EXPO_PUBLIC_NUTRITION_USE_MOCK=false
EXPO_PUBLIC_FEATURED_USE_MOCK=false
EXPO_PUBLIC_RESTAURANT_MERCHANT_USE_MOCK=false

# Mobility's scheduled-rides layer has no live backend — scheduled.api.ts falls
# back to EXPO_PUBLIC_MOBILITY_USE_MOCK and is intentionally left on mock.
# check-env-mocks: allow EXPO_PUBLIC_SCHEDULED_USE_MOCK  no live scheduled-rides backend
