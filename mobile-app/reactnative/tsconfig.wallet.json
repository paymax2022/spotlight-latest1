{
  "//": "Scoped typecheck config for the Connect wallet/gifting/tier/payout money screens. Run: npx tsc -p tsconfig.wallet.json",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "noEmit": true
  },
  "include": [
    "app/connect/wallet/**/*.ts",
    "app/connect/wallet/**/*.tsx",
    "src/features/connect/wallet/**/*.ts",
    "src/features/connect/wallet/**/*.tsx",
    "src/features/connect/components/wallet-CaptureRow.tsx",
    "src/features/connect/components/wallet-MoneyAmount.tsx",
    "src/features/connect/components/wallet-SolicitationGuard.tsx",
    "src/features/connect/components/wallet-WalletEntryRow.tsx"
  ],
  "exclude": ["node_modules"]
}
