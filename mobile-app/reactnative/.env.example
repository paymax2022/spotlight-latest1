EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
# Address lookup base. Options:
#   • unset            → '/api/v1/maps' on EXPO_PUBLIC_API_BASE_URL (frontend-web
#                        Next proxy → Go). Requires frontend-web running on :3000.
#   • a full URL       → hit the Go backend directly (frontend-web need not run).
#                        Requires the Go origin in backend CORS_ALLOW_ORIGINS
#                        (http://localhost:8081 is allowed by default now).
#   • off | offline    → offline-only address lookup (no network, clean console).
# Leave UNSET for the web build (localhost:8083): the proxy route is same-origin
# and CORS-safe. A full URL hits the Go backend cross-origin and only works if
# that origin is in the backend's CORS_ALLOW_ORIGINS (defaults to :8081).
# EXPO_PUBLIC_MAPS_BASE_URL=
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-local-supabase-anon-key
EXPO_PUBLIC_PASSWORD_RESET_REDIRECT_URL=paymaxrn://auth/reset-password
EXPO_PUBLIC_APP_ENV=development

# Paystack public key for the in-app gateway (Inline SDK on web + WebView on native).
# Use the SAME pk_test_… value as the web app's NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY.
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx

# In-app SDK checkout for the server-initialized flows (wallet funding, bills,
# registration). 'true' resumes the server transaction inside the in-app Paystack
# SDK and returns to a status screen. Anything else (or unset) keeps the legacy
# external-browser redirect (Linking.openURL). Requires react-native-webview on native.
EXPO_PUBLIC_SDK_CHECKOUT=false

# Realtor module data source: 'false' hits Supabase + the AI route.
# Anything else (or unset) uses mock data so the app runs with no backend.
EXPO_PUBLIC_REALTOR_USE_MOCK=true

# Fractional Real Estate module data source: 'false' calls the live backend (/api/v1/fractionalre); anything else (or unset) uses persisted mock data.
EXPO_PUBLIC_FRACTIONALRE_USE_MOCK=true

# Doctor (provider) module data source: 'false' calls the live backend (/api/v1/doctor).
# Anything else (or unset) uses mock/demo data so the app runs with no backend.
EXPO_PUBLIC_DOCTOR_USE_MOCK=true

# Association / Group-membership module data source: 'false' calls the live
# /associations endpoints (see contracts/associations.openapi.yaml). Anything
# else (or unset) uses in-app mock data so the module runs with no backend.
EXPO_PUBLIC_ASSOCIATION_USE_MOCK=false

# Crypto (Paymax Invest) module data source: 'false' calls the Go backend in
# ./backend (endpoints under /api/v1/crypto, /portfolio, /watchlists, /alerts,
# /invest/eligibility). Anything else (or unset) uses in-app mock data.
# To run live:  1) cd backend && go run ./cmd/server   (listens on :8080)
#               2) set the two vars below, then restart Expo.
EXPO_PUBLIC_CRYPTO_USE_MOCK=true

# Stocks (Paymax Invest) module data source: 'false' calls the Go backend
# (/api/v1/stocks/* + /api/v1/portfolio?assetType=stock). Anything else = mock.
EXPO_PUBLIC_STOCKS_USE_MOCK=true

# Admin console data source: 'false' calls the Go admin API (/api/v1/admin/*,
# RBAC via X-Admin-Role header). Anything else = mock.
EXPO_PUBLIC_ADMIN_USE_MOCK=true

# Featured Placement (paid landing-page promotion) data source: 'false' calls the
# Go backend (/api/v1/placement/* + /api/v1/landing/placements). Anything else
# (or unset) uses in-app mock zones/campaigns so the wizard, My Promotions, and
# the home Featured section all work standalone with no backend running.
EXPO_PUBLIC_FEATURED_USE_MOCK=true

# Point the shared API client at the Go service to run crypto and/or stocks live.
# Other modules stay on their own mock flags.
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Insurance / "Protection" data source. Unset (or 'true') uses in-app mock
# products so the hub works standalone. 'false' hits the live Go catalog via the
# frontend-web proxy (/api/v1/insurance → /api/finance/insurance) — requires the
# frontend-web dev server + Go backend running with FEATURE_INSURANCE_ENABLED=true
# and the insurance_products table seeded. For a quick UAT: `npm run uat:insurance`
# (starts :8083 with this flag flipped to false for that run only).
EXPO_PUBLIC_INSURANCE_USE_MOCK=true

# Mobility (transport) data source for all 8 modes.
# 'false' hits the live Go backend (/api/finance/{mobility,driver}). Requires
# FEATURE_TRANSPORT_ENABLED=true + FEATURE_TRANSPORT_MODES_ENABLED=true on the
# backend and MAPS_PROVIDER=http + MAPS_BASE_URL pointing at the real gateway.
# Per-mode flags fall back to EXPO_PUBLIC_MOBILITY_USE_MOCK when unset, so
# flipping just that one flag switches all 8 modes at once.
EXPO_PUBLIC_MOBILITY_USE_MOCK=true
EXPO_PUBLIC_PARCEL_USE_MOCK=true
EXPO_PUBLIC_BUS_USE_MOCK=true
EXPO_PUBLIC_TOWING_USE_MOCK=true
EXPO_PUBLIC_MOVERS_USE_MOCK=true
EXPO_PUBLIC_CARHIRE_USE_MOCK=true
EXPO_PUBLIC_LOGISTICS_USE_MOCK=true
EXPO_PUBLIC_EVENT_USE_MOCK=true

# Visitor / Gate module: 'false' calls the live /api/v1/visitor/* handlers.
# Anything else (or unset) uses in-app mock data so the module runs with no backend.
EXPO_PUBLIC_VISITOR_USE_MOCK=false

# FX (multi-currency exchange). Default (unset/'true') = in-app mocks.
# 'false' routes the exchange through /api/v1/fx/* → frontend-web proxy → Go
# orchestration (Maplerad sandbox). Backend must have FEATURE_FX_ORCHESTRATION_ENABLED=true
# + MAPLERAD_SECRET_KEY set; frontend-web must have FEATURE_FX_ENABLED=true.
# Core exchange (rates/quote/lock/convert/balances/transactions) is backed.
# Beneficiaries + rate-alerts are persistence-backed (Supabase orch_beneficiaries
# / orch_rate_alerts). Remaining features (rate-history, transfer-by-ref,
# collections, disputes, add-wallet, virtual cards) are STUBBED server-side:
# contract-shaped, not persisted.
EXPO_PUBLIC_FX_USE_MOCK=true

# Estate Elections: 'false' calls the live /api/v1/elections/* handlers.
# Anything else (or unset) uses in-app mock data.
EXPO_PUBLIC_ELECTION_USE_MOCK=false

EXPO_PUBLIC_MERCHANT_USE_MOCK=false   # set true to use in-app mock data (no backend needed)

# Voting (contests/leaderboard/paid votes) module data source: 'false' calls the
# live backend (/voting/* + /api/votes/paid/{initiate,verify}). Anything else
# (or unset) uses in-app mock data so the module runs with no backend.
# false = live Connect voting API (contests, roster, free votes).
EXPO_PUBLIC_VOTING_USE_MOCK=false

# Connect (dating / social / discovery) data source. 'false' hits the live Go
# backend under /api/v1/connect/* (proxied through the shared API base). For the
# discovery surface to actually return data the backend MUST have:
#   FEATURE_CONNECT_ENABLED=true  (else /api/v1/connect/* returns 503)
#   the connect migrations applied on the LOCAL stack (`supabase migration up`,
#     NOT `supabase db push` until go-live)
#   RBAC perms seeded for the signed-in user: connect.discovery.access (stack /
#     swipe / likes-you / nearby / rewind) and connect.boost.purchase (boosts)
#     — a missing perm 403s the corresponding endpoint.
# Anything else (or unset) uses in-app mock candidates so discovery runs with no
# backend. Boost purchase is a MONEY path: it charges the wallet in kobo through
# the shared PaymentSheet with a fresh Idempotency-Key.
EXPO_PUBLIC_CONNECT_USE_MOCK=false

# Address lookup is served entirely by the backend MapService proxy
# (EXPO_PUBLIC_MAPS_BASE_URL above), which is standardized on Google
# (autocomplete + geocoding + Distance Matrix). The Google key lives server-side
# (backend MAPS_GOOGLE_KEY) and is NEVER shipped in the app. When the proxy is
# unreachable (dev/demo), the app uses a built-in offline geocoder so address
# fields still work. Set EXPO_PUBLIC_ADDRESS_OFFLINE=false to disable that.

# Nutrition Resolution Engine data source: 'false' calls the Go backend via the
# Next proxy (/api/v1/nutrition/* → /api/finance/nutrition/*) for dish nutrition
# profiles, cart summaries, and vendor recipe/confirm/allergen writes. Anything
# else (or unset) uses in-app mock profiles so buyers see honest estimated
# nutrition + allergens and vendors can run the confirm flow with no backend.
EXPO_PUBLIC_NUTRITION_USE_MOCK=true

# Transfers (Send Money) module data source — wallet→wallet (Paymax P2P),
# wallet→bank, and bank→bank. 'false' calls the live Next proxy
# (/api/v1/transfers/* — banks, resolve-account, pin, bank, bank-to-bank).
# Anything else (or unset) uses in-app mock data (realistic Nigerian bank list,
# offline account resolve, and a "set PIN" first-run) so the whole transfer
# flow — including the PIN gate and receipts — runs standalone with no backend.
EXPO_PUBLIC_TRANSFERS_USE_MOCK=true

# Health module data source (records vault, consult intake, Pre-Consult intake
# wizard M1–M17): 'false' calls the Go backend via the Next proxy
# (/api/v1/health/* → /api/finance/health/*). Anything else (or unset) uses
# in-app mock data so the health features — including the offline Pre-Consult
# intake wizard — run with no backend.
EXPO_PUBLIC_HEALTH_USE_MOCK=true

# Events (ticketing + cashless event wallet) module data source: live by
# default. Set to 'true' to opt into in-app mock/demo data (discovery,
# tickets, organiser dashboard, event wallet) when the Go backend
# (/api/finance/events/*, backend/internal/top5events) isn't running.
EXPO_PUBLIC_EVENTS_USE_MOCK=false
