EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
# MapService proxy (Go backend). Point at the Go service's /api/finance/maps base.
# If unset, it is derived from EXPO_PUBLIC_API_BASE_URL.
EXPO_PUBLIC_MAPS_BASE_URL=http://localhost:8080/api/finance/maps
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-local-supabase-anon-key
EXPO_PUBLIC_PASSWORD_RESET_REDIRECT_URL=paymaxrn://auth/reset-password
EXPO_PUBLIC_APP_ENV=development

# Realtor module data source: 'false' hits Supabase + the AI route.
# Anything else (or unset) uses mock data so the app runs with no backend.
EXPO_PUBLIC_REALTOR_USE_MOCK=true

# Doctor (provider) module data source: 'false' calls the live backend (/api/v1/doctor).
# Anything else (or unset) uses mock/demo data so the app runs with no backend.
EXPO_PUBLIC_DOCTOR_USE_MOCK=true

# Association / Group-membership module data source: 'false' calls the live
# /associations endpoints (see contracts/associations.openapi.yaml). Anything
# else (or unset) uses in-app mock data so the module runs with no backend.
EXPO_PUBLIC_ASSOCIATION_USE_MOCK=false

# Crypto (Paymax Invest) module data source: 'false' calls the Go backend in
# ./backend (endpoints under /api/v1/crypto, /portfolio, /watchlists, /alerts,
# /invest/eligibility). Anything else (or unset) uses in-app mock data.
# To run live:  1) cd backend && go run ./cmd/server   (listens on :8080)
#               2) set the two vars below, then restart Expo.
EXPO_PUBLIC_CRYPTO_USE_MOCK=true
# Point the shared API client at the Go service when running crypto live.
# Other modules stay on their own mock flags, so only crypto goes live.
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Mobility (ride-hailing) data source: 'false' hits the live Go backend via
# /api/finance/{mobility,driver}. Requires the frontend-web gateway rewrite
# (GO_BACKEND_URL) so the default :3000 base reaches Go, OR set
# EXPO_PUBLIC_API_BASE_URL to the Go service directly. Backend needs
# FEATURE_TRANSPORT_ENABLED=true. Anything else (or unset) uses in-app mock data.
EXPO_PUBLIC_MOBILITY_USE_MOCK=true
# Multi-modal screens (parcel, bus, towing, movers, car hire) fall back to this
# flag unless a per-mode override is set. Set false to hit the live Go backend.
# EXPO_PUBLIC_PARCEL_USE_MOCK / _BUS_ / _TOWING_ / _MOVERS_ / _CARHIRE_USE_MOCK

# Visitor / Gate module: 'false' calls the live /api/v1/visitor/* handlers.
# Anything else (or unset) uses in-app mock data so the module runs with no backend.
EXPO_PUBLIC_VISITOR_USE_MOCK=false

# Estate Elections: 'false' calls the live /api/v1/elections/* handlers.
# Anything else (or unset) uses in-app mock data.
EXPO_PUBLIC_ELECTION_USE_MOCK=false

EXPO_PUBLIC_MERCHANT_USE_MOCK=false   # set true to use in-app mock data (no backend needed)
