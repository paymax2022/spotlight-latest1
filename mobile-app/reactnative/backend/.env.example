# paymax/crypto-backend — environment template (COMMITTED — never put real secrets here).
#
# HOW TO USE:
#   cp .env.example .env        # .env is gitignored — put REAL secrets in .env ONLY
#   # then either:
#   #   (docker)  docker compose up --build          # compose loads .env automatically
#   #   (direct)  set -a; source .env; set +a; go run ./cmd/server
#
# The Go service reads these via internal/config.Load() (os.Getenv). It does NOT
# auto-load a .env file — docker-compose interpolation or `source` is what loads it.
# Leave a provider's keys blank to keep that module on the built-in MOCK.

# ── Core ───────────────────────────────────────────────────────────────────────
PORT=8080
# Omit DATABASE_URL to use the in-memory store; set it to use Postgres.
DATABASE_URL=

# ── Auth (Supabase) ────────────────────────────────────────────────────────────
# Set ONE of these in any real environment. Unset + ALLOW_DEV_AUTH!=true = fail-closed.
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
# Dev only: allow the no-token "demo-user" fallback. NEVER set in production.
ALLOW_DEV_AUTH=false
# Only trust the X-Admin-Role header behind a trusted proxy that injects it.
TRUST_ADMIN_ROLE_HEADER=false

# ── HTTP hardening ─────────────────────────────────────────────────────────────
# Comma-separated allowlist; empty = safe localhost dev default (never "*").
CORS_ALLOW_ORIGINS=
RATE_LIMIT_RPS=50
# HMAC-SHA256 secret for inbound provider webhooks (POST /api/v1/crypto/webhooks/{provider}).
# These events MUTATE money state (deposit.confirmed credits a holding,
# withdrawal.failed reverses a debit), so auth is FAIL-CLOSED: if this is unset the
# endpoint returns 503 unless ALLOW_DEV_AUTH=true (dev only). MUST be set in every
# real environment. Generate with: openssl rand -hex 32
CRYPTO_WEBHOOK_SECRET=

# ── STOCKS venue: Alpaca BROKER API (brokerage) ────────────────────────────────
# Set the key+secret to route the stocks module through Alpaca. Blank = mock broker.
# Broker API sandbox host: https://broker-api.sandbox.alpaca.markets (Basic auth).
# ALPACA_ACCOUNT_ID is the sub-account orders are placed on (per-user mapping later);
# create one via POST /v1/accounts in the sandbox and paste its id.
ALPACA_BASE_URL=https://broker-api.sandbox.alpaca.markets
ALPACA_API_KEY=CK6QYLYQ6QLIROEKSBGTUPBVZV
ALPACA_API_SECRET=9VsRHHbBdnjZ8HusTYNPiy8SDfMApYFXBbEDGNA28K1Y
ALPACA_CLIENT_ID=CK6QYLYQ6QLIROEKSBGTUPBVZV

# ── CRYPTO venue: Quidax (market data / liquidity / custody) ────────────────────
# Set the API key to route the crypto module through Quidax. Blank = mock adapters.
# Base URL example: https://app.quidax.io/api/v1
QUIDAX_BASE_URL=
QUIDAX_API_KEY=
QUIDAX_API_SECRET=

# ── Generic HTTP provider (fallback, only if not using Quidax) ──────────────────
PROVIDER=
PROVIDER_BASE_URL=
PROVIDER_API_KEY=

# ── Money-core ledger consolidation (Stage 1.5) ────────────────────────────────
# mock (default) | shadow (additive validation) | http (authoritative later).
LEDGER_BACKEND=mock
LEDGER_BASE_URL=
LEDGER_SERVICE_TOKEN=
