# =============================================================================
# Paymax x Spotlight Super App — STAGING env TEMPLATE
# =============================================================================
# Copy to `.env.staging` and fill the CHANGE_ME placeholders before building.
#   cp .env.staging.example .env.staging
#   node scripts/check-env-mocks.mjs .env.staging
#
# Staging exists to exercise the REAL backend with REAL data. Every
# `*_USE_MOCK` flag below is therefore "false". This matters more than it looks:
# each flag defaults to MOCK when it is missing, so an incomplete staging env
# does not fail loudly — it quietly serves fixtures and the test passes against
# data nobody wrote. The flag list below is generated from the source tree by
# scripts/check-env-mocks.mjs, which fails the build on any flag it finds in
# code but not here.
#
# Point this at the STAGING Supabase project and the STAGING API — never at
# production. Staging writes real rows through the real ledger.
# =============================================================================

# ── Core ─────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_BASE_URL=https://CHANGE_ME-staging.example.com
EXPO_PUBLIC_APP_ENV=staging
EXPO_PUBLIC_SUPABASE_URL=https://CHANGE_ME-staging.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_CHANGE_ME
EXPO_PUBLIC_PASSWORD_RESET_REDIRECT_URL=https://CHANGE_ME-staging.example.com/login
EXPO_PUBLIC_SENTRY_ENVIRONMENT=staging
EXPO_PUBLIC_HEALTH_PHARMACY_SYMPTOM_SEARCH=true

# ── Live data layers (all mocks OFF) ─────────────────────────────────────────
EXPO_PUBLIC_ACADEMY_FEES_USE_MOCK=false
EXPO_PUBLIC_ACADEMY_USE_MOCK=false
EXPO_PUBLIC_ADMIN_USE_MOCK=false
