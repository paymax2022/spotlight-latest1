{
  "expo": {
    "name": "Paymax React Native",
    "slug": "paymax-react-native-app",
    "scheme": "paymaxrn",
    "icon": "./assets/branding/icon.png",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Spotlight needs access to your photos so you can add a cover image and gallery to your campaign.",
          "cameraPermission": "Spotlight needs access to your camera so you can take a photo for your campaign."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Spotlight needs camera access to scan visitor QR codes at the gate."
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#340075"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Spotlight uses your location to set your delivery and pickup address accurately.",
          "locationWhenInUsePermission": "Spotlight uses your location to set your delivery and pickup address accurately."
        }
      ],
      "@maplibre/maplibre-react-native",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "android": {
      "package": "com.anonymous.paymaxreactnativeapp",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "ios": {
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "localhost": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            },
            "10.0.2.2": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            },
            "127.0.0.1": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        },
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.anonymous.paymaxreactnativeapp"
    },
    "web": {
      "favicon": "./assets/branding/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c69cdff3-1818-47f8-9d72-658a2c83832d"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c69cdff3-1818-47f8-9d72-658a2c83832d"
    }
  }
}
