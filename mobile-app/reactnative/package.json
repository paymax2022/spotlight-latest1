{
  "name": "paymax-react-native-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "prestart": "node scripts/check-web-api.mjs",
    "start": "expo start --port 8083",
    "android": "expo run:android",
    "build:android": "cd android && ./gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a",
    "build:ios": "react-native run-ios --configuration Release",
    "ios": "expo run:ios",
    "preweb": "node scripts/check-web-api.mjs",
    "web": "expo start --web --port 8083",
    "uat:insurance": "EXPO_PUBLIC_INSURANCE_USE_MOCK=false expo start --web --port 8083",
    "typecheck": "node --stack-size=15000 --max-old-space-size=8192 ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "check:confirm": "node scripts/check-no-alert-confirm.mjs",
    "test:payment-routes": "node scripts/smoke-payment-routes.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:server-profile": "node --experimental-strip-types --test \"src/lib/__tests__/serverProfile*.test.ts\"",
    "test:association-upload": "node --experimental-strip-types --test \"src/features/association/api/__tests__/*.test.ts\"",
    "test:property-roles": "node --experimental-strip-types --test \"src/features/property/roles/__tests__/*.test.ts\"",
    "test:restaurant-taxonomy": "node --experimental-strip-types --import ./tests/unit/register-ts-paths.mjs --test \"src/features/restaurantmerchant/__tests__/*.test.ts\"",
    "test:merchant": "node --experimental-strip-types --test \"src/features/merchant/lib/__tests__/*.test.ts\"",
    "test:billing-email": "node --experimental-strip-types --test \"src/features/payments/__tests__/*.test.ts\"",
    "test:vet-pet": "node --experimental-strip-types --test \"src/features/health/vet/__tests__/*.test.ts\"",
    "test:mobility": "node --experimental-strip-types --test \"src/features/mobility/utils/__tests__/*.test.ts\"",
    "test:delivery-onboarding": "node --experimental-strip-types --test \"src/features/mobility/__tests__/*.test.ts\"",
    "test:referral-home": "node --experimental-strip-types --test \"src/features/referral/home/__tests__/*.test.ts\"",
    "test:insurance": "node --experimental-strip-types --test \"src/features/insurance/__tests__/*.test.ts\"",
    "test:wallet-idempotency": "node --experimental-strip-types --test \"src/features/connect/wallet/__tests__/*.test.ts\"",
    "test:kyc-verify": "node --experimental-strip-types --test \"src/features/kycverify/__tests__/*.test.ts\"",
    "test:registration": "node --experimental-strip-types --import ./tests/unit/register-ts-paths.mjs --test \"tests/unit/registration/*.spec.ts\"",
    "test:voting": "node --experimental-strip-types --import ./tests/unit/register-ts-paths.mjs --test \"tests/unit/voting/*.spec.ts\"",
    "test:crowdfunding": "node --experimental-strip-types --import ./tests/unit/register-ts-paths.mjs --test \"tests/unit/crowdfunding/*.spec.ts\"",
    "test:auth": "node --experimental-strip-types --import ./tests/unit/register-ts-paths.mjs --test \"tests/unit/auth/*.spec.ts\"",
    "test:account": "node --experimental-strip-types --import ./tests/unit/register-ts-paths.mjs --test \"tests/unit/account/*.spec.ts\"",
    "test:connect": "node --experimental-strip-types --import ./tests/unit/register-ts-paths.mjs --test \"tests/unit/connect/*.spec.ts\"",
    "test:savings": "node --experimental-strip-types --import ./tests/unit/register-ts-paths.mjs --test \"tests/unit/savings/*.spec.ts\"",
    "test:telemedicine": "node --experimental-strip-types --import ./tests/unit/register-ts-paths.mjs --test \"tests/unit/telemedicine/*.spec.ts\"",
    "test:payments": "node --experimental-strip-types --import ./tests/unit/register-ts-paths.mjs --test \"tests/unit/payments/*.spec.ts\"",
    "test:modules": "node --experimental-strip-types --import ./tests/unit/register-ts-paths.mjs --test \"tests/unit/modules/*.spec.ts\"",
    "test:emergencies": "node --experimental-strip-types --import ./tests/unit/register-ts-paths.mjs --test \"tests/unit/emergencies/*.spec.ts\"",
    "test:food": "node --experimental-strip-types --import ./tests/unit/register-ts-paths.mjs --test \"tests/unit/food/*.spec.ts\"",
    "test:marketplace": "node --experimental-strip-types --import ./tests/unit/register-ts-paths.mjs --test \"tests/unit/marketplace/*.spec.ts\"",
    "test:location": "node --experimental-strip-types --import ./tests/unit/register-ts-paths.mjs --test \"tests/unit/location/*.spec.ts\"",
    "test:merchant2": "node --experimental-strip-types --import ./tests/unit/register-ts-paths.mjs --test \"tests/unit/merchant2/*.spec.ts\"",
    "test:merchantws": "node --experimental-strip-types --import ./tests/unit/register-ts-paths.mjs --test \"tests/unit/merchantws/*.spec.ts\"",
    "test:outlets": "node --experimental-strip-types --import ./tests/unit/register-ts-paths.mjs --test \"tests/unit/outlets/*.spec.ts\"",
    "test:pharmacymerchant": "node --experimental-strip-types --import ./tests/unit/register-ts-paths.mjs --test \"tests/unit/pharmacymerchant/*.spec.ts\"",
    "test:wallet": "node --experimental-strip-types --import ./tests/unit/register-ts-paths.mjs --test \"tests/unit/wallet/*.spec.ts\"",
    "test:events": "node --experimental-strip-types --import ./tests/unit/register-ts-paths.mjs --test \"tests/unit/events/*.spec.ts\"",
    "check:env-mocks": "node scripts/check-env-mocks.mjs",
    "check:env-mocks:staging": "node scripts/check-env-mocks.mjs .env.staging",
    "env:staging": "node scripts/use-env.mjs staging",
    "env:develop": "node scripts/use-env.mjs development",
    "env:which": "node scripts/use-env.mjs --which",
    "test:lib": "node --experimental-strip-types --import ./tests/unit/register-ts-paths.mjs --test \"tests/unit/lib/*.spec.ts\"",
    "test:academy-live": "node --experimental-strip-types --import ./tests/unit/register-ts-paths.mjs --test \"src/features/academy/live/__tests__/*.test.ts\"",
    "test:film-academy": "node --experimental-strip-types --import ./tests/unit/register-ts-paths.mjs --test \"tests/unit/filmAcademy/*.spec.ts\"",
    "test:crypto": "node --experimental-strip-types --import ./tests/unit/register-ts-paths.mjs --test \"src/features/crypto/utils/__tests__/*.test.ts\""
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^13.0.0",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@hookform/resolvers": "^6.0.0",
    "@livekit/react-native": "^3.0.0",
    "@livekit/react-native-expo-plugin": "^1.0.3",
    "@livekit/react-native-webrtc": "144.2.0",
    "@maplibre/maplibre-react-native": "^10.4.2",
