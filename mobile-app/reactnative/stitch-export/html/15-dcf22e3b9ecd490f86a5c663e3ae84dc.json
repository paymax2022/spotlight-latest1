{"screenId":"dcf22e3b9ecd490f86a5c663e3ae84dc","projectId":"13229605076739728032","htmlContent":"<!DOCTYPE html>\n<html class=\"light\" lang=\"en\">\n<head>\n    <meta charset=\"utf-8\"/>\n    <meta content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\" name=\"viewport\"/>\n    <title>Paymax - Premium Fintech Super-App</title>\n    \n    <!-- External Scripts and Fonts -->\n    <script src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"></script>\n    <link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap\" rel=\"stylesheet\">\n    \n    <!-- React & Router CDNs -->\n    <script src=\"https://unpkg.com/react@18/umd/react.development.js\"></script>\n    <script src=\"https://unpkg.com/react-dom@18/umd/react-dom.development.js\"></script>\n    <script src=\"https://unpkg.com/history@5/umd/history.development.js\"></script>\n    <script src=\"https://unpkg.com/react-router@6.3.0/umd/react-router.development.js\"></script>\n    <script src=\"https://unpkg.com/react-router-dom@6.3.0/umd/react-router-dom.development.js\"></script>\n    <script src=\"https://unpkg.com/babel-standalone@6/babel.min.js\"></script>\n\n    <style>\n        .material-symbols-outlined {\n            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n        }\n        .glass-card {\n            background: rgba(255, 255, 255, 0.7);\n            backdrop-filter: blur(20px);\n            border: 1px solid rgba(255, 255, 255, 0.2);\n        }\n        body {\n            font-family: 'Plus Jakarta Sans', sans-serif;\n            background-color: #f8f9ff;\n            background-image: \n                radial-gradient(at 0% 0%, rgba(52, 0, 117, 0.05) 0px, transparent 50%),\n                radial-gradient(at 100% 0%, rgba(0, 81, 213, 0.05) 0px, transparent 50%);\n            min-height: 100vh;\n        }\n        .animate-cursor {\n            animation: cursor-blink 1s infinite;\n        }\n        @keyframes cursor-blink {\n            0%, 100% { opacity: 1; }\n            50% { opacity: 0; }\n        }\n        .pb-safe { padding-bottom: env(safe-area-inset-bottom, 1rem); }\n    </style>\n\n    <script id=\"tailwind-config\">\n        tailwind.config = {\n            darkMode: \"class\",\n            theme: {\n                extend: {\n                    \"colors\": {\n                        \"surface-container\": \"#e5eeff\",\n                        \"on-surface\": \"#0b1c30\",\n                        \"on-secondary-fixed-variant\": \"#003ea8\",\n                        \"secondary-fixed\": \"#dbe1ff\",\n                        \"on-tertiary-fixed-variant\": \"#005049\",\n                        \"surface-container-highest\": \"#d3e4fe\",\n                        \"on-primary-container\": \"#b994ff\",\n                        \"tertiary-fixed\": \"#89f5e7\",\n                        \"secondary-container\": \"#316bf3\",\n                        \"inverse-on-surface\": \"#eaf1ff\",\n                        \"secondary-fixed-dim\": \"#b4c5ff\",\n                        \"surface\": \"#f8f9ff\",\n                        \"tertiary\": \"#002d28\",\n                        \"primary\": \"#4c1d95\", // Custom specified\n                        \"on-secondary-fixed\": \"#00174b\",\n                        \"on-primary-fixed-variant\": \"#572ba0\",\n                        \"primary-fixed-dim\": \"#d3bbff\",\n                        \"on-error-container\": \"#93000a\",\n                        \"on-secondary\": \"#ffffff\",\n                        \"surface-bright\": \"#f8f9ff\",\n                        \"on-surface-variant\": \"#4a4452\",\n                        \"primary-fixed\": \"#ebdcff\",\n                        \"background\": \"#f8f9ff\",\n                        \"on-tertiary\": \"#ffffff\",\n                        \"surface-tint\": \"#6f46b9\",\n                        \"surface-dim\": \"#cbdbf5\",\n                        \"error\": \"#ba1a1a\",\n                        \"tertiary-fixed-dim\": \"#6bd8cb\",\n                        \"error-container\": \"#ffdad6\",\n                        \"surface-container-high\": \"#dce9ff\",\n                        \"on-primary\": \"#ffffff\",\n                        \"inverse-surface\": \"#213145\",\n                        \"outline\": \"#7b7483\",\n                        \"tertiary-container\": \"#00453f\",\n                        \"outline-variant\": \"#ccc3d4\",\n                        \"secondary\": \"#0051d5\",\n                        \"on-tertiary-container\": \"#48b8ac\",\n                        \"surface-container-lowest\": \"#ffffff\",\n                        \"surface-container-low\": \"#eff4ff\",\n                        \"primary-container\": \"#4c1d95\",\n                        \"on-tertiary-fixed\": \"#00201d\",\n                        \"on-background\": \"#0b1c30\",\n                        \"on-error\": \"#ffffff\",\n                        \"surface-variant\": \"#d3e4fe\",\n                        \"inverse-primary\": \"#d3bbff\",\n                        \"on-secondary-container\": \"#fefcff\",\n                        \"on-primary-fixed\": \"#260059\"\n                    },\n                    \"borderRadius\": {\n                        \"DEFAULT\": \"0.25rem\",\n                        \"lg\": \"0.5rem\",\n                        \"xl\": \"0.75rem\",\n                        \"xxl\": \"1.5rem\",\n                        \"full\": \"9999px\"\n                    },\n                    \"spacing\": {\n                        \"xxl\": \"48px\",\n                        \"lg\": \"24px\",\n                        \"xs\": \"4px\",\n                        \"sm\": \"8px\",\n                        \"xl\": \"32px\",\n                        \"gutter\": \"16px\",\n                        \"base\": \"4px\",\n                        \"md\": \"16px\",\n                        \"container-margin\": \"20px\"\n                    }\n                }\n            }\n        }\n    </script>\n<style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head>\n<body class=\"bg-background text-on-background\">\n    <div id=\"root\"></div>\n\n    <script type=\"text/babel\">\n        const { useState, useEffect } = React;\n        const { createRoot } = ReactDOM;\n        const { MemoryRouter, Routes, Route, Link, useNavigate, useLocation } = ReactRouterDOM;\n\n        // --- Shared Components ---\n\n        const BottomNav = () => {\n            const location = useLocation();\n            const isActive = (path) => location.pathname === path;\n\n            return (\n                <nav className=\"fixed bottom-0 left-0 w-full bg-surface/80 backdrop-blur-xl border-t border-white/20 shadow-[0px_-4px_20px_rgba(0,0,0,0.05)] flex justify-around items-center px-4 py-3 pb-safe z-50 rounded-t-xl\">\n                    <Link to=\"/\" className={`flex flex-col items-center justify-center transition-all ${isActive('/') ? 'text-primary scale-100' : 'text-on-surface-variant opacity-60 hover:text-primary'}`}>\n                        <span className=\"material-symbols-outlined\" style={{ fontVariationSettings: isActive('/') ? \"'FILL' 1\" : \"\" }}>account_balance_wallet</span>\n                        <span className=\"text-[12px] font-semibold mt-1\">Wallet</span>\n                    </Link>\n                    <Link to=\"/services\" className={`flex flex-col items-center justify-center transition-all ${isActive('/services') ? 'text-primary scale-100' : 'text-on-surface-variant opacity-60 hover:text-primary'}`}>\n                        <span className=\"material-symbols-outlined\" style={{ fontVariationSettings: isActive('/services') ? \"'FILL' 1\" : \"\" }}>grid_view</span>\n                        <span className=\"text-[12px] font-semibold mt-1\">Services</span>\n                    </Link>\n                    <Link to=\"/search\" className={`flex flex-col items-center justify-center transition-all ${isActive('/search') ? 'text-primary scale-100' : 'text-on-surface-variant opacity-60 hover:text-primary'}`}>\n      