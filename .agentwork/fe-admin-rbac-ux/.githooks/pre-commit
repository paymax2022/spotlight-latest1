#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

bash scripts/update-gitignore.sh --write >/dev/null

if ! git diff --quiet -- .gitignore frontend-web/.gitignore; then
  git add .gitignore frontend-web/.gitignore
  echo "pre-commit: refreshed and staged managed .gitignore files"
fi

