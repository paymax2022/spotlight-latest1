# >>> AUTO-MANAGED: update-gitignore >>>
# OS/editor artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Env files (keep examples)
.env
.env.*
!.env.example
!.env.*.example
frontend-web/.env
frontend-web/.env.*
!frontend-web/.env.example
!frontend-web/.env.*.example

# Node and package manager artifacts
node_modules/
**/node_modules/
.npm-cache/
**/.npm-cache/
.pnpm-store/
.yarn/

# Build outputs and caches
.next/
**/.next/
dist/
build/
out/
coverage/
*.tsbuildinfo

# Sensitive keys/certs (keep out of git by default)
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa
id_dsa

# Logs and temp
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# <<< AUTO-MANAGED: update-gitignore <<<
