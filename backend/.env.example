# Backend env template — copy to .env and fill in. Never commit real secrets.

# Deployment environment: development (default) | staging | production.
# In production, startup FAILS if a required secret is missing, a placeholder, or
# the wrong shape (e.g. a pk_ key in PAYSTACK_SECRET_KEY). See internal/config/validate.go.
APP_ENV=development

FEATURE_FX_ORCHESTRATION_ENABLED=true

# Paymax Mobility (ride-hailing). Turn ON to expose /api/finance/{mobility,driver}
# and /api/finance/admin/transport routes. Uses the mock maps adapter until a real
# provider is wired behind the MapsAdapter interface.
FEATURE_TRANSPORT_ENABLED=true

# Multi-modal expansion (parcel, bus, towing, movers, car hire). Single flag gating
# all five modes' routes. Reuses the same drivers/settlement/safety/pricing infra.
FEATURE_TRANSPORT_MODES_ENABLED=true

# ── Transport Trip Scheduling ─────────────────────────────────────────────────
# Lets users schedule FUTURE logistics movements (ride_hail / ride_share /
# parcel_intra / parcel_inter / airport_pickup / bus). OFF by default. When ON it
# exposes /api/finance/mobility/scheduled/* + /api/finance/admin/transport/scheduled/*
# AND enables the transport-scheduler worker (cmd/transport-scheduler), which
# materializes the real booking + escrows via `settlement` at lead time.
# The worker also reads this flag and exits immediately if it is false.
FEATURE_TRANSPORT_SCHEDULING_ENABLED=false
# Lead time = how long BEFORE scheduled_pickup_at the worker materializes + escrows
# the real trip/parcel/bus. Stored per-booking (lead_time_minutes, default 30). No
# separate env knob today; per-mode defaults live in backend/internal/transport
# (scheduled_dispatch.go). Escrow happens AT DISPATCH, never at scheduling time.
# NOTE(reminders): 24h/1h pre-pickup reminders are currently LOG-ONLY and
# DB-idempotent (reminder_24h_sent_at / reminder_1h_sent_at). A real notification
# provider is NOT yet wired into the transport Service — see the TODO(notifications)
# injection point in the reminders path and the RUNBOOK punch-list before go-live.

# Admin gate for /api/finance/admin/* (incl. transport). When empty, admin routes
# are open (dev only). Set a strong value in prod; clients send x-admin-api-key.
ADMIN_API_KEY=
APP_PORT=8080

# Paymax Invest (stock trading) module. Keep OFF until compliance + broker
# readiness. Uses mock broker + market-data adapters until real ones are wired.
FEATURE_INVEST_ENABLED=false
# Dev only: accept any 4–6 digit PIN without enrolling a real one. NEVER true in prod.
FEATURE_INVEST_PIN_DEV_BYPASS=false
# Real provider adapters — leave blank to use the deterministic mock adapters.
# Point these at the partner gateway (or a shim mapping it onto the documented
# JSON contract in internal/invest/provider_http.go).
INVEST_MARKETDATA_BASE_URL=
INVEST_MARKETDATA_API_KEY=
INVEST_BROKER_BASE_URL=
INVEST_BROKER_API_KEY=
INVEST_BROKER_WEBHOOK_SECRET=

# ── Academy rails seam (RAILS_MODE) ──────────────────────────────────────────
# Selects the adapter for the four unbacked academy rails (BNPL, payout,
# disbursement, billing) WITHOUT changing the code path:
#   fake    → local deterministic fake service (tools/fakes, :9100). DEFAULT.
#   sandbox → same HTTP adapter, provider sandbox (differ: base URL + creds).
#   live    → same HTTP adapter, production creds.
#   off/""  → no HTTP adapter; each package keeps its in-process dev stub.
# In every non-off mode the inbound webhook is HMAC-SHA256 signature-verified.
RAILS_MODE=fake

# Per-rail base URL + API key + webhook secret. The HTTP adapter is used for a rail
# only when RAILS_MODE is active AND that rail's base URL is set. For local FAKE the
# base URLs point at the fakes service; the webhook secret MUST match FAKE_WEBHOOK_SECRET
# (or the per-rail secret) configured on the fakes service. SERVER-SIDE ONLY.
BNPL_BASE_URL=http://localhost:9100
BNPL_API_KEY=
BNPL_WEBHOOK_SECRET=dev-fake-secret

PAYOUT_BASE_URL=http://localhost:9100
PAYOUT_API_KEY=
PAYOUT_WEBHOOK_SECRET=dev-fake-secret

DISBURSE_BASE_URL=http://localhost:9100
DISBURSE_API_KEY=
DISBURSE_WEBHOOK_SECRET=dev-fake-secret

BILLING_BASE_URL=http://localhost:9100
BILLING_API_KEY=
BILLING_WEBHOOK_SECRET=dev-fake-secret

# ── Crypto price feed + on-chain withdrawal provider (Quidax) ────────────────────
# CRYPTO_PROVIDER selects the implementation: "mock" (default, deterministic, no
# network) or "quidax" (real HTTP adapter — live NGN prices + real withdrawals).
# Provision BOTH credential sets: the TEST set is used in dev/staging and the LIVE
# set in production (selected automatically by APP_ENV / IsProd). If the selected
# set's key is empty the module safely falls back to the deterministic mock.
# Get API keys from the Quidax dashboard. Base URL default: https://app.quidax.io/api/v1
CRYPTO_PROVIDER=mock
QUIDAX_TEST_API_KEY=
QUIDAX_TEST_BASE_URL=https://app.quidax.io/api/v1
QUIDAX_LIVE_API_KEY=
QUIDAX_LIVE_BASE_URL=https://app.quidax.io/api/v1

# Maplerad provider credentials (get from the Maplerad dashboard).
MAPLERAD_SECRET_KEY=mpr_sandbox_sk_xxxxxxxx
MAPLERAD_PUBLIC_KEY=mpr_sandbox_pk_xxxxxxxx
MAPLERAD_PROD=false
MAPLERAD_WEBHOOK_SECRET=

# Eversend provider credentials.
EVERSEND_CLIENT_ID=
EVERSEND_CLIENT_SECRET=
EVERSEND_PROD=false
EVERSEND_WEBHOOK_SECRET=

# ── Bank transfers (wallet→bank + bank→bank), multi-provider ──────────────────
# Member routes under /api/finance/transfers/* are gated by FEATURE_BANK_TRANSFERS_ENABLED.
# Leave the provider creds blank to run fully offline: each adapter falls back to a
# deterministic mock (mock-first when creds blank / on transport error), so dev/CI
# work with no network. Put REAL keys in backend/.env.local (never commit them).
FEATURE_BANK_TRANSFERS_ENABLED=false

# Paystack (disbursement + webhook signing). Dummy placeholders for dev.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Monnify (disbursement provider 2). auth = base64(API_KEY:SECRET_KEY) → bearer.
# CONTRACT_CODE funds single disbursements; WEBHOOK_SECRET signs inbound events
# (HMAC-SHA512 of the raw body, header "monnify-signature"). Dummy placeholders.
MONNIFY_API_KEY=MK_TEST_XXXXXXXXXXXX
MONNIFY_SECRET_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
MONNIFY_CONTRACT_CODE=0000000000
MONNIFY_PROD=false
MONNIFY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Routing: default disbursement provider + auto-failover to the other on error.
TRANSFER_PROVIDER_DEFAULT=paystack
TRANSFER_FAILOVER_ENABLED=true

DATABASE_URL=postgres://user:pass@localhost:5432/paymax?sslmode=disable
REDIS_URL=redis://localhost:6379

# ── MapService (provider-agnostic maps abstraction) ──────────────────────────
# Turn ON to expose /api/finance/maps/*. Provider selection is config-driven via
# MAPS_CONFIG_PATH ({primitive -> provider} per surface). All keys are
# server-side ONLY — the client calls our backend, never a provider.
#
# Single legitimate key per provider. Do NOT add multi-account/multi-key rotation
# to dodge free-tier limits — it violates provider terms. Cost control is via
# caching, PostGIS, quotas, and graceful degradation only.
FEATURE_MAPS_ENABLED=false
MAPS_CONFIG_PATH=
MAPS_DEFAULT_SURFACE=default

# Generic HTTP maps provider (real geocoding + routing/ETA behind a documented
# JSON contract — see internal/maps/provider_http.go). Set MAPS_PROVIDER=http and
# MAPS_BASE_URL to point at a gateway/shim that fronts Google Distance Matrix /
# Directions / Geocoding, Mapbox, or any service speaking the contract. Distances
# are returned in METRES and durations in SECONDS (the units the transport pricing
# engine expects). MAPS_API_KEY is sent as a Bearer token and is server-side only.
# Leave MAPS_PROVIDER=mock (or blank base URL) to use the deterministic offline
# mock — dev/CI stay fully functional with no network calls.
MAPS_PROVIDER=mock         # mock (default) | http
MAPS_BASE_URL=             # e.g. https://maps-gw.partner.example/v1
MAPS_API_KEY=              # Bearer token for the gateway (optional)

# OpenStack stack. Basemap tiles (maptiler) + route polylines/tracking (osrm)
# stay here. Geocode/reverse/autocomplete/matrix now default to Google (above);
# geoapify/osrm remain as FALLBACKS when Google errors. Blank key → mock stand-in.
MAPS_GEOAPIFY_KEY=          # OSM-licensed geocode/reverse fallback (cacheable)
MAPS_MAPTILER_KEY=          # basemap vector tiles + styles (display layer)
MAPS_OSRM_BASE_URL=         # self-hosted OSRM, e.g. http://osrm:5000 (routes/tracking)
MAPS_TILE_STYLE_URL=        # optional explicit MapLibre style URL override

# ── Multi-provider KYC verification (ADR-013). Secrets server-side ONLY. ──
# Default OFF. When true in production, Validate() requires KYC_PII_ENC_KEY and
# at least one configured provider.
FEATURE_KYC_VERIFY_ENABLED=false
# AES-256 key for encrypting KYC PII blobs at rest: base64 of exactly 32 bytes.
# Generate: `openssl rand -base64 32`
KYC_PII_ENC_KEY=
KYC_FACIAL_MATCH_THRESHOLD=70
# Capability routing (ordered providers per check type; admin-editable after seed).
KYC_ROUTE_ID_NUMBER=dojah,youverify
KYC_ROUTE_ID_FACIAL=dojah,smileid
KYC_ROUTE_LIVENESS=dojah,smileid
KYC_ROUTE_DOCUMENT=dojah,smileid
KYC_ROUTE_AML=dojah,youverify
# Dojah — Authorization:<secret> + AppId:<app_id>; sandbox→live.
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
DOJAH_PROD=false
DOJAH_WEBHOOK_SECRET=
# Smile ID — partner_id + api key + request signature; async callback.
SMILEID_PARTNER_ID=
SMILEID_API_KEY=
SMILEID_PROD=false
SMILEID_CALLBACK_URL=
# Youverify — token secret; isSubjectConsent must be true; async webhooks.
YOUVERIFY_TOKEN=
YOUVERIFY_PROD=false
YOUVERIFY_WEBHOOK_SECRET=

# ── Arena competition engine (ADR-014). Default OFF. Signing seeds server-side ──
# only. When true in production, Validate() requires >=1 valid Ed25519 seed.
FEATURE_ARENA_ENABLED=false
# Per-adapter Ed25519 signing seeds for the Merit ledger: base64 of exactly 32
# bytes. Generate: `openssl rand -base64 32`. Public keys are registered per
# competition in arena_authorized_adapter; only these adapters can sign merit.
ARENA_SIGNING_SEED_THEORY=
ARENA_SIGNING_SEED_PRACTICAL=
ARENA_SIGNING_SEED_FIRSTAID=
# Dedicated crown-award signing key (NDC-1 defense-in-depth). Optional but
# recommended: keeps the crown signature off the merit adapter keys. base64 of 32
# bytes, e.g. `openssl rand -base64 32`. Falls back to the practical signer if unset.
ARENA_AWARD_SIGNING_SEED=

# Google — primary provider for ALL address lookup: autocomplete, geocoding,
# reverse geocoding, external POI search, AND Distance Matrix (delivery-fee
# driving distance + ETA). Server-side ONLY; the app never sees this key.
# Requires FEATURE_MAPS_ENABLED=true. Google results are NEVER cached (per Google
# terms); the MapLibre/OSM basemap still serves display tiles. When this key is
# blank, a deterministic mock stands in so dev/CI stay functional.
# Enable the Places, Geocoding, and Distance Matrix APIs on the key's project.
MAPS_GOOGLE_KEY=

# Mapbox — OPTIONAL: static images + map-match fallback.
MAPS_MAPBOX_TOKEN=

# Cost guard: per-user requests/min on /api/finance/maps/* (Redis-backed if
# REDIS_URL is set, else in-memory), and a webhook for 50/75/90% budget alerts.
MAPS_RATE_LIMIT_PER_MIN=120
MAPS_BUDGET_ALERT_WEBHOOK=

# ── Micro-Insurance / Protection (Partnering Insurtech) ──────────────────────
# SERVICE = "MICRO INSURANCE". Turn ON to expose /api/finance/insurance,
# /api/insurance/admin and /internal/webhooks/{mycover,octamile}. Two provider
# rails behind the provider-agnostic underwriter-gateway; keys are server-side
# secrets — never commit real values, never log them.
FEATURE_INSURANCE_ENABLED=false

# ── Top-5 Event Ticketing + cashless Event Wallet (internal/top5events) ───────
# Gates RegisterEvents → member /api/finance/events/* + admin /api/events/admin/*.
# Must be true or the mobile /events tab 404s. Reuses wallet/ledger/escrow rails.
FEATURE_EVENTS_ENABLED=false

# PROVIDER 1 — MyCover.ai (general micro, wallet, health, PA, credit-life, device, SME, Spotlight)
INSURANCE_MYCOVER_API_KEY=            # SECRET_KEY (server-to-server auth)
INSURANCE_MYCOVER_PUBLIC_KEY=         # PUBLIC_KEY (publishable)
INSURANCE_MYCOVER_WEBHOOK_SECRET=     # signs POST /internal/webhooks/mycover
INSURANCE_MYCOVER_BASE_URL=           # blank → provider sandbox

# PROVIDER 2 — Octamile (ride/logistics/parcel/bus/motor/GIT, driver/rider/passenger)
INSURANCE_OCTAMILE_API_KEY=           # SECRET_KEY (server-to-server auth)
INSURANCE_OCTAMILE_PUBLIC_KEY=        # PUBLIC_KEY (publishable)
INSURANCE_OCTAMILE_WEBHOOK_SECRET=    # signs POST /internal/webhooks/octamile
INSURANCE_OCTAMILE_BASE_URL=          # blank → provider sandbox

# ── Pharmacy — symptom-based medication search ────────────────────────────────
# Symptom-guided product discovery (NOT diagnosis, NOT prescribing): term →
# concept → condition cluster (triage tier T1–T4) → therapeutic class → live
# SKUs. Turn ON to expose /pharmacy/symptom-search, /pharmacy/classes/{id}/skus
# and the pharmacist console (/admin/pharmacy/mappings, /admin/pharmacy/reviews).
# Requires FEATURE_PHARMACY_ENABLED=true — the gate is AND, not OR. NDPR:
# symptom queries are sensitive health data (per-device rate-limited, excluded
# from general analytics). See ADR-016.
# Rate limit: per-user+device 20 req/min (keyed on user_id|hashed X-Device-Id;
# salt compiled in). Redis-backed when REDIS_URL is set — the window holds
# across backend instances — with an in-memory per-instance fallback otherwise.
# Retention IS automated (NDPR): a background loop runs
# pharmacy_symptom_events_purge() at startup and every 24h (migration 20260830,
# symptomsearch.StartRetentionPurge), deleting symptom_search_events older than
# SYMPTOM_EVENTS_RETENTION_DAYS. Optional override below (default 180 days).
# HARD GATE: superintendent-pharmacist sign-off on the APPROVED taxonomy +
# gating rules is required before this is ever true in production (runbook §0).
FEATURE_PHARMACY_SYMPTOM_SEARCH_ENABLED=false
# Optional: NDPR retention window (days) for symptom_search_events. Default 180.
SYMPTOM_EVENTS_RETENTION_DAYS=180

# ── Paymax Marketplace — Jiji-style classifieds + escrow checkout ──────────────
# Feature-flagged (OFF by default; no flag → routes/state-machines never register).
# Gates /v1/marketplace member+admin routes, the public HMAC webhooks (logistics
# delivery-confirmed + payments funding-confirmed), and the escrow order/dispute/
# boost FSMs. Money moves through the existing finance double-entry ledger — the
# marketplace never stores a balance. See docs/prd/marketplace/RUNBOOK.md.
FEATURE_MARKETPLACE_ENABLED=false

# Elasticsearch read-model URL for GET /v1/marketplace/search. When EMPTY, search
# returns 501 SEARCH_NOT_WIRED (graceful) and the rest of the marketplace still
# works. Local docker-compose ES: http://elasticsearch:9200 (host: :9200).
# NOTE the two consumers use different var names, both pointing at the same cluster:
#   - API server (internal/config)         → ELASTICSEARCH_URL
#   - indexer binary (cmd/marketplace-indexer) → ES_URL
ELASTICSEARCH_URL=
ES_URL=

# HMAC secret verifying the two public marketplace webhooks
# (POST /v1/marketplace/webhooks/logistics/delivery-confirmed and
#  POST /v1/marketplace/webhooks/payments/funding-confirmed). Must match the
# secret configured on the logistics + payments providers. Rotate via the
# secrets manager in prod; never commit a real value.
PAYMAX_WEBHOOK_SECRET=dev-fake-secret

# Optional: ES indexer poll interval in milliseconds (default 2000).
MARKETPLACE_INDEXER_INTERVAL_MS=2000

# ── Direct Referral Rewards ENGINE (single-level, purchase-triggered) ─────────
# Gates /v1/referrals (user) + /v1/admin/referrals (RBAC) + /internal/referrals
# (service-to-service). Reuses wallet/ledger; supersedes the §7A house model.
FEATURE_REFERRAL_REWARDS_ENABLED=true
# Shared secret guarding /internal/referrals/* purchase hooks. Empty ⇒ 503.
REFERRAL_REWARDS_INTERNAL_SECRET=

# create one via POST /v1/accounts in the sandbox and paste its id.
ALPACA_BASE_URL=https://broker-api.sandbox.alpaca.markets
ALPACA_API_KEY=CK6QYLYQ6QLIROEKSBGTUPBVZV
ALPACA_API_SECRET=9VsRHHbBdnjZ8HusTYNPiy8SDfMApYFXBbEDGNA28K1Y
ALPACA_CLIENT_ID=CK6QYLYQ6QLIROEKSBGTUPBVZV


# Savings — early-break penalty for withdrawing from a LOCK vault before
# maturity, in basis points (1000 = 10%). SERVER-SIDE POLICY: this used to be
# read from the request body, so a member could break a lock for free by
# sending penalty_bps: 0. An out-of-range value is rejected at startup and the
# 1000 default is kept.
SAVINGS_EARLY_BREAK_PENALTY_BPS=1000

# AI-trading fund (backend/internal/trading). Two gates:
#   FEATURE_TRADING_ENABLED    mounts Module-KYC + fund wallet at
#                              /api/v1/trading and /api/v1/admin/trading
#   FEATURE_AI_TRADING_ENABLED additionally exposes /evaluate and the
#                              promotion-ladder admin routes
# Neither executes a real venue order; cash moves only through the finance
# ledger. TRADING_FEE_BPS must be in (0,10000] or the performance fee fails
# closed and charges nothing.
FEATURE_TRADING_ENABLED=false
FEATURE_AI_TRADING_ENABLED=false
TRADING_FEE_BPS=2000
TRADING_HURDLE_BPS=0

# Association / group-membership module (backend/internal/association). TWO
# flags are required, and they gate DIFFERENT things — setting only one leaves a
# failure that looks like the other layer is broken:
#
#   FEATURE_ASSOCIATIONS_ENABLED (PLURAL)
#     Read by config.go (getEnvBool, default false) and gates
#     association.RegisterRoutes(finance.Group("/associations")). Off ⇒ the Go
#     routes are never registered and /api/finance/associations returns 404 —
#     indistinguishable from a wrong proxy path.
#
#   FEATURE_ASSOCIATION_ENABLED (SINGULAR)
#     NOT referenced anywhere in Go source: it is stored in the database as
#     platform_modules.env_flag for key 'association' and resolved dynamically by
#     the module registry, so grepping the repo for it finds nothing. Off ⇒
#     Module.VisibleIn() is false ⇒ GET /api/v1/modules/visibility omits the
#     module ⇒ the mobile route guard redirects to /module-unavailable
#     ("Not available yet"), even though the API is healthy.
#
# The singular name is ALSO the Next.js flag in frontend-web/.env.local, which
# gates the /api/finance/associations proxy route (503 when off). Three gates
# total; the module only works with all three on.
#
# Visibility additionally needs the DB rows: platform_modules.lifecycle='active'
# and platform_module_environments.status='visible' for this environment.
FEATURE_ASSOCIATIONS_ENABLED=false
FEATURE_ASSOCIATION_ENABLED=false

# ── Cloudflare R2 object storage ─────────────────────────────────────────────
# Presigned uploads/downloads. FIVE features wire a presigner from these vars
# (association logos, estate, transport, and others in finance_routes.go), and
# every one of them FAILS CLOSED when the config is incomplete: the presign
# endpoint answers 503 "…uploads are not configured" and the UI has to fall back
# to a pasted URL.
#
# Configured() requires ALL of endpoint + bucket + key id + secret. A partial
# config is treated as absent, so setting three of the four looks identical to
# setting none. Leaving them blank locally is fine — uploads are simply
# unavailable and the app says so.
R2_ACCOUNT_ENDPOINT=      # https://<accountid>.r2.cloudflarestorage.com
R2_BUCKET=                # no default — unset means uploads are OFF, not a guessed bucket
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto

# Digital membership-card HMAC secret. REQUIRED whenever APP_ENV != development —
# startup aborts without it. Unset in development falls back to a public constant
# compiled into the repo, which is forgeable; never rely on that outside local dev.
ASSOC_CARD_SIGNING_SECRET=

