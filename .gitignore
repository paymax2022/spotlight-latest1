# >>> AUTO-MANAGED: update-gitignore >>>
# OS/editor artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Env files (keep examples)
.env
.env.*
!.env.example
!.env.*.example
frontend-web/.env
frontend-web/.env.*
!frontend-web/.env.example
!frontend-web/.env.*.example

# Node and package manager artifacts
node_modules/
**/node_modules/
.npm-cache/
**/.npm-cache/
.pnpm-store/
.yarn/

# Build outputs and caches
.next/
**/.next/
dist/
build/
out/
coverage/
*.tsbuildinfo

# Compiled Go binaries (build artifacts — never track). Anchored to the repo-root
# backend binaries so they never match the backend/cmd/* source packages.
/backend/server
/backend/marketplace-cron

# Sensitive keys/certs (keep out of git by default)
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa
id_dsa

# Logs and temp
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# <<< AUTO-MANAGED: update-gitignore <<<

# --- Launch hardening (manual): secret-leak prevention ---
# Editor "Local History" and agent worktrees committed .env snapshots before.
# Never track these trees again.
.history/
**/.history/
.agentwork/
**/.agentwork/
# Claude Code agent worktrees: committed as gitlinks by accident; their gitdirs
# get pruned, leaving dangling refs that break `git status`. Never track these.
.claude/worktrees/
**/.claude/worktrees/

# Catch underscore/timestamp env snapshot variants the .env.* rule misses
# (e.g. .env_20260601180248.local written by the Local History extension).
.env_*
**/.env_*
.env.local
**/.env.local
launch/master.env

# --- Compiled Go binaries (build outputs, never source) ---
# Previously committed (54MB + 17MB) and a major cause of repo bloat.
/backend/server
/backend/marketplace-cron
