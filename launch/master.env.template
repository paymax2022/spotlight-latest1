# ============================================================================
#  Paymax × Spotlight — MASTER credential file  (fill once, apply everywhere)
# ============================================================================
#  HOW TO USE
#    1. Copy this file:        cp launch/master.env.template launch/master.env
#    2. Fill in the values below (master.env is git-ignored — never committed).
#    3. Apply to every surface: bash launch/apply-env.sh
#       → writes backend/.env, frontend-web/.env.local,
#         frontend-admin/.env.local, mobile-app/reactnative/.env
#    4. Re-run apply-env.sh any time you rotate a key.
#
#  NOTES
#    - Values use ONE logical name here; apply-env.sh maps each to the correct
#      per-surface variable name + prefix (NEXT_PUBLIC_/EXPO_PUBLIC_/server).
#    - REQUIRED = needed for the "Core + Payments" launch scope you chose.
#    - OPTIONAL = leave blank to keep that feature mocked/disabled for now.
#    - TEST vs LIVE: use sk_test_/pk_test_ now, switch to sk_live_/pk_live_
#      for production. Set PAYSTACK_MODE accordingly.
# ============================================================================


# ─── CORE PLATFORM (REQUIRED) ───────────────────────────────────────────────
# Supabase — Project Settings → API. URL + anon (public) + service-role (secret).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres direct connection for the Go money-path (Supabase → Connection string,
# "Direct connection" / session pooler). Format:
#   postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DATABASE_URL=

# Redis (idempotency cache, Redlock, asynq queue). Managed Redis URL.
#   redis://default:PASSWORD@HOST:6379
REDIS_URL=

# Admin API key — protects /api/.../admin/* routes. Generate a strong value:
#   openssl rand -hex 32
ADMIN_API_KEY=

# Public base URLs (where each app is reachable in production).
SITE_URL_WEB=https://app.paymax.ng
API_BASE_URL_PUBLIC=https://api.paymax.ng/api/v1
GO_BACKEND_URL=https://api.paymax.ng
ADMIN_API_BASE_URL=https://api.paymax.ng/api/v1
CORS_ALLOW_ORIGINS=https://app.paymax.ng,https://admin.paymax.ng


# ─── PAYMENTS — PAYSTACK (REQUIRED) ─────────────────────────────────────────
# Dashboard → Settings → API Keys & Webhooks. Use test keys until go-live.
PAYSTACK_MODE=test            # test | live
PAYSTACK_PUBLIC_KEY=          # pk_test_... / pk_live_...
PAYSTACK_SECRET_KEY=          # sk_test_... / sk_live_...  (SECRET, server only)
PAYSTACK_WEBHOOK_SECRET=      # used to verify inbound webhook HMAC-SHA512
PAYSTACK_DVA_BANK=wema-bank   # preferred bank for dedicated virtual accounts


# ─── UTILITY BILLS — VTPASS (OPTIONAL) ──────────────────────────────────────
# Currently set to LIVE on disk. Leave blank to keep utility payments disabled.
VTPASS_ENVIRONMENT=           # sandbox | live
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=            # PK_...
VTPASS_SECRET_KEY=            # SK_...
# Encryption key for stored provider creds — generate: openssl rand -base64 32
UTILITY_PROVIDER_CREDENTIALS_KEY=


# ─── FX — MAPLERAD / EVERSEND (OPTIONAL) ────────────────────────────────────
MAPLERAD_SECRET_KEY=          # mpr_sandbox_sk_... / mpr_prod_sk_...
MAPLERAD_PUBLIC_KEY=          # mpr_sandbox_pk_... / mpr_prod_pk_...
MAPLERAD_PROD=false           # true → production base URL
MAPLERAD_WEBHOOK_SECRET=
EVERSEND_CLIENT_ID=
EVERSEND_CLIENT_SECRET=
EVERSEND_PROD=false
EVERSEND_WEBHOOK_SECRET=


# ─── STORAGE — CLOUDFLARE R2 (OPTIONAL) ─────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# No default. "spotlight-open-mic" sat here for a long time and does not exist
# in the R2 account; because a bucket name is only checked for being non-empty,
# that made every generated environment look configured and then fail at upload
# with NoSuchBucket. Blank means uploads are OFF and say so (503), which is the
# failure you want. Set it per environment — staging and production do not
# necessarily share a bucket.
R2_BUCKET=
# Endpoint is derived from account id if left blank:
#   https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ENDPOINT=
R2_PUBLIC_BASE_URL=           # optional public CDN URL for objects


# ─── EMAIL (OPTIONAL — pick ONE) ────────────────────────────────────────────
# Mailgun (frontend-web transactional) ...
MAILGUN_API_KEY=
MAILGUN_DOMAIN=paymax.ng
MAILGUN_REGION=us             # us | eu
# ... or Resend (backend + voting service)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Spotlight <no-reply@spotlightng.com>
EMAIL_FROM=Spotlight <no-reply@spotlightng.com>


# ─── SMS / PUSH (OPTIONAL) ──────────────────────────────────────────────────
TERMII_API_KEY=
TERMII_SENDER_ID=Paymax
EXPO_PUSH_TOKEN=              # optional Expo push access token


# ─── AI / RTC / MAPS (OPTIONAL) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Real-time video for telemedicine — pick a provider:
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
VIDEOSDK_API_KEY=
VIDEOSDK_SECRET=
# Maps: keep MAPS_PROVIDER=mock to run offline; set to http + keys to go live.
MAPS_PROVIDER=mock            # mock | http
MAPS_GEOAPIFY_KEY=
MAPS_MAPTILER_KEY=
MAPS_OSRM_BASE_URL=
MAPS_GOOGLE_KEY=
MAPS_MAPBOX_TOKEN=


# ─── INVEST PROVIDERS (OPTIONAL — keep flag OFF until compliance) ───────────
INVEST_BROKER_BASE_URL=
INVEST_BROKER_API_KEY=
INVEST_BROKER_WEBHOOK_SECRET=
INVEST_MARKETDATA_BASE_URL=
INVEST_MARKETDATA_API_KEY=


# ─── OTHER (OPTIONAL) ───────────────────────────────────────────────────────
STITCH_API_KEY=
OPENAI_API_KEY=              # referenced by supabase/config.toml only
PAYMAX_WEBHOOK_OUT_URL=
PAYMAX_WEBHOOK_SECRET=
CONNECT_VERIFICATION_PEPPER= # openssl rand -hex 32  (if Connect module enabled)
