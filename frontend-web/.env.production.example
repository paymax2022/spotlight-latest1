# =============================================================================
# frontend-web — PRODUCTION environment example
# -----------------------------------------------------------------------------
# Copy to `.env.production` (or set these in the cPanel / Passenger environment)
# and replace every placeholder with a REAL value. This file contains NO real
# secrets — placeholders only. Never commit a filled-in copy.
#
# Only the variables required to run the production server + the live order-
# tracking WebSocket path are documented here. See `.env.example` for the full
# (dev-oriented) list.
# =============================================================================

# -----------------------------------------------------------------------------
# Go backend (server-side proxy + live-order WebSocket)
# -----------------------------------------------------------------------------
# HTTP base for the Go API. Used by src/lib/go-backend.ts proxyToGoBackend.
# Must be reachable from the Next.js Node process, NOT from the browser.
GO_BACKEND_URL=https://api.your-domain.example

# Optional explicit ws(s):// base for the Go backend. If unset, the WS ticket
# endpoint derives it from GO_BACKEND_URL by swapping http→ws / https→wss.
# Set this only when the WS endpoint lives on a different host/scheme.
# GO_BACKEND_WS_URL=wss://api.your-domain.example

# Shared secret used to HMAC-sign short-lived WebSocket tickets minted by
# app/api/v1/restaurant/orders/[id]/ws. The Go backend must validate tickets
# with the SAME secret. REQUIRED in production — the ticket endpoint fails
# closed (no ticket is issued) when this is absent.
# Generate with: openssl rand -hex 32
WS_TICKET_SIGNING_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# Ticket lifetime in seconds (default 60). Keep this short — long enough to
# open the socket, short enough that a leaked ticket is useless quickly.
# WS_TICKET_TTL_SECONDS=60

# -----------------------------------------------------------------------------
# Supabase (auth + data)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Service-role key — server-side only (Bearer JWT validation, admin tasks).
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# =============================================================================
# FEATURE FLAGS  (read by src/lib/feature-flags.ts)
# -----------------------------------------------------------------------------
# Every flag is OFF unless the value is EXACTLY the string 'true'. The safe
# production default is therefore `false` for ALL of them — enable a module only
# once it has been verified in production. Flip the relevant flag to 'true' to
# turn a module on.
# =============================================================================
FEATURE_WALLET_ENABLED=false
FEATURE_KYC_ENABLED=false
FEATURE_VIRTUAL_ACCOUNTS_ENABLED=false
# Vote bridge (atomic free-vote path). PROD ENABLEMENT IS GATED — see
# docs/adr/ADR-001-vote-engine-deprecation.md: (1) deploy the claim_free_vote
# migration, (2) confirm contestant_votes has zero new rows, THEN set this true.
# Enabling before the migration ships will 500 all free votes.
VOTES_BRIDGE_ENABLED=false
FEATURE_REFERRALS_ENABLED=false
FEATURE_INSURANCE_ENABLED=false
FEATURE_STAYS_ENABLED=false
FEATURE_EVENTS_ENABLED=false
FEATURE_SOCIAL_PAY_ENABLED=false
FEATURE_SAVINGS_ENABLED=false
FEATURE_CREATORS_ENABLED=false
FEATURE_LOYALTY_ENABLED=false
FEATURE_HEALTH_ENABLED=false
FEATURE_HEALTH_PHARMACY_ENABLED=false
FEATURE_HEALTH_LAB_ENABLED=false
FEATURE_HEALTH_VET_ENABLED=false
FEATURE_FINTECH_ADMIN_ENABLED=false
FEATURE_TIER_LIMITS_ENABLED=false
FEATURE_UTILITY_PAYMENTS_ENABLED=false
FEATURE_WALLET_TRANSFERS_ENABLED=false
FEATURE_BANK_TRANSFERS_ENABLED=false
FEATURE_BENEFICIARIES_ENABLED=false
FEATURE_GROUPS_ENABLED=false
FEATURE_ESTATE_ENABLED=false
FEATURE_CROWDFUNDING_ENABLED=false
# Required ON for the food/restaurant live-order WebSocket route to respond.
FEATURE_RESTAURANT_ENABLED=false
FEATURE_TELEMEDICINE_ENABLED=false
FEATURE_TRANSPORT_ENABLED=false
FEATURE_AICARE_ENABLED=false
FEATURE_VOTE_BRIDGE_ENABLED=false
FEATURE_FX_ENABLED=false
FEATURE_REALTOR_ENABLED=false
FEATURE_DISPUTES_ENABLED=false
FEATURE_RATINGS_ENABLED=false
FEATURE_ASSOCIATION_ENABLED=false
