NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# =============================================================================
# ADMIN AUTH — required to protect all /api/admin/* routes.
# Any request without a valid JWT OR this key is rejected with 401.
# Generate with: openssl rand -hex 32
# =============================================================================
SPOTLIGHT_ADMIN_API_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_SECRET_KEY=sk_test_xxx

RESEND_API_KEY=re_xxx
EMAIL_FROM="Spotlight <no-reply@example.com>"
CONTACT_INBOX_EMAIL=info@example.com

# Cloudflare R2 storage for direct Open Mic MP3 uploads.
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET=spotlight-open-mic
# Optional if objects are public via a custom domain; signed admin URLs do not require this.
R2_PUBLIC_BASE_URL=

# =============================================================================
# UNIVERSAL VOTING ENGINE
# =============================================================================

# Paystack webhook secret — set to your Paystack secret key (same as PAYSTACK_SECRET_KEY).
# The webhook handler verifies HMAC-SHA512 signatures against this key.
# PAYSTACK_SECRET_KEY is already used for this; no additional variable needed.

# Optional: override default vote payment reference prefix (default: SPT-VOTE)
# VOTE_PAYMENT_REF_PREFIX=SPT-VOTE

# Optional: set to 'true' to enable verbose voting engine debug logs
# VOTING_DEBUG=false

# =============================================================================
# FINTECH FEATURE FLAGS — docs/build-playbook.md
# All flags default OFF (absent = disabled). Set to exactly 'true' to enable.
# Feature-flag every new module — CLAUDE.md iron rule.
# =============================================================================

# Block 2: KYC tiers and document verification (EPIC 2)
FEATURE_KYC_ENABLED=false

# Block 3 & 4: Wallet / ledger (EPIC 1)
FEATURE_WALLET_ENABLED=false

# Block 5: Paystack Dedicated Virtual Accounts (EPIC 3)
FEATURE_VIRTUAL_ACCOUNTS_ENABLED=false

# Block 6: Vote bridge — idempotency fix + KYC gate on voting paths (EPIC 4)
VOTES_BRIDGE_ENABLED=false

# Block 7: Per-tier daily wallet and vote limits
FEATURE_TIER_LIMITS_ENABLED=false

# Block 8: Referral codes and wallet rewards (EPIC 5)
FEATURE_REFERRALS_ENABLED=false

# Block 9: Admin maker-checker for financial operations (EPIC 6)
FEATURE_FINTECH_ADMIN_ENABLED=false

# Utility bills payment engine
FEATURE_UTILITY_PAYMENTS_ENABLED=false
# Required before saving utility provider API credentials. Generate with:
# openssl rand -base64 32
UTILITY_PROVIDER_CREDENTIALS_KEY=
# Default provider request timeout in milliseconds. Per-provider config.timeout_ms overrides this.
UTILITY_PROVIDER_TIMEOUT_MS=15000

# VTPass utility provider adapter credentials.
# Do not commit real values. VTPass requires api-key + public-key for GET and api-key + secret-key for POST.
VTPASS_ENVIRONMENT=sandbox
VTPASS_BASE_URL=
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=

# =============================================================================
# GO BACKEND — finance API base URL used by Next.js vote bridge
# =============================================================================
GO_API_BASE_URL=http://localhost:8080

# Direct Postgres connection for Go finance services (pgx pool).
# Use Supabase connection pooler URL (session mode) for direct DB access.
DATABASE_URL=

# Redis (for Redlock, idempotency cache, asynq, WS pub/sub)
REDIS_URL=redis://localhost:6379

# Maplerad credentials (FX + alternative VA provider)
MAPLERAD_SECRET_KEY=
MAPLERAD_PROD=false

# =============================================================================
# P3 VERTICAL MODULE FEATURE FLAGS (Go backend)
# All default OFF. Set to exactly 'true' to enable in Go backend via env.
# Mirror in Go: backend/internal/config/config.go
# =============================================================================

# P3 Lane B: Community groups with ledger-backed dues payments
FEATURE_GROUPS_ENABLED=false

# P3 Lane C: Ticketed events with QR codes and settlement
FEATURE_EVENTS_ENABLED=false

# P3 Lane D: Estate management with visitor passes and private elections
FEATURE_ESTATE_ENABLED=false

# P3 Lane E: Crowdfunding campaigns with escrow and refunds
FEATURE_CROWDFUNDING_ENABLED=false

# P3 Lane F: Restaurant and food delivery with rider dispatch
FEATURE_RESTAURANT_ENABLED=false

# P3 Lane G: Telemedicine — doctors, appointments, prescriptions
FEATURE_TELEMEDICINE_ENABLED=false

# Transport (ride-hailing): drivers, trips, fare settlement
FEATURE_TRANSPORT_ENABLED=false

# AI Customer Care: chat sessions, escalation to human agents
FEATURE_AICARE_ENABLED=false

# P3 Lane H: Wallet-paid votes (requires FEATURE_WALLET_ENABLED + VOTES_BRIDGE_ENABLED)
FEATURE_VOTE_BRIDGE_ENABLED=false

# FX currency exchange via Maplerad (requires MAPLERAD_SECRET_KEY)
FEATURE_FX_ENABLED=false
