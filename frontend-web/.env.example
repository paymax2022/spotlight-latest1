NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# =============================================================================
# ADMIN AUTH — required to protect all /api/admin/* routes.
# Any request without a valid JWT OR this key is rejected with 401.
# Generate with: openssl rand -hex 32
# =============================================================================
SPOTLIGHT_ADMIN_API_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_SECRET_KEY=sk_test_xxx

RESEND_API_KEY=re_xxx
EMAIL_FROM="Spotlight <no-reply@example.com>"
CONTACT_INBOX_EMAIL=info@example.com

# Cloudflare R2 storage for direct Open Mic MP3 uploads.
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET=spotlight-open-mic
# Optional if objects are public via a custom domain; signed admin URLs do not require this.
R2_PUBLIC_BASE_URL=

# =============================================================================
# UNIVERSAL VOTING ENGINE
# =============================================================================

# Paystack webhook secret — set to your Paystack secret key (same as PAYSTACK_SECRET_KEY).
# The webhook handler verifies HMAC-SHA512 signatures against this key.
# PAYSTACK_SECRET_KEY is already used for this; no additional variable needed.

# Optional: override default vote payment reference prefix (default: SPT-VOTE)
# VOTE_PAYMENT_REF_PREFIX=SPT-VOTE

# Optional: set to 'true' to enable verbose voting engine debug logs
# VOTING_DEBUG=false
