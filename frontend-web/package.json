{
    "name": "infotek",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "dev:clean": "rm -rf .next && next dev",
        "dev:reset": "sh -c 'for p in 3000 3001 3002; do lsof -ti tcp:$p | xargs kill -9 2>/dev/null || true; done; rm -rf .next; next dev'",
        "build": "next build",
        "start": "next start",
        "lint": "next lint",
        "sass": "sass --watch public/assets/scss/main.scss:public/assets/css/main.css"
    },
    "dependencies": {
        "@sentry/nextjs": "^10.53.1",
        "@supabase/supabase-js": "^2.106.0",
        "class-variance-authority": "^0.7.1",
        "date-fns": "^4.2.1",
        "next": "^14.2.35",
        "pino": "^10.3.1",
        "react": "18.2.0",
        "react-countup": "^6.5.3",
        "react-dom": "18.2.0",
        "react-modal-video": "^2.0.1",
        "react-scroll-trigger": "^0.6.14",
        "sass": "^1.72.0",
        "sharp": "^0.34.5",
        "swiper": "^12.1.4",
        "wowjs": "^1.1.3"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.0",
        "autoprefixer": "^10.5.0",
        "typescript": "6.0.3",
        "vitest": "^4.1.6"
    }
}
