#!/usr/bin/env bash
set -euo pipefail

max_size_mb="${MAX_PUSH_FILE_MB:-50}"
max_size_bytes=$((max_size_mb * 1024 * 1024))

# Block generated/cached files and local-only artifacts.
blocked_pattern='(^|/)\.next/|(^|/)\.npm-cache/|(^|/)node_modules/|(^|/)\.DS_Store$|(^|/)\.env\.local$|\.tsbuildinfo$'

tmp_refs="$(mktemp)"
cat >"$tmp_refs"

if [[ ! -s "$tmp_refs" ]]; then
  exit 0
fi

zero_sha="0000000000000000000000000000000000000000"
tmp_objects="$(mktemp)"

while read -r local_ref local_sha remote_ref remote_sha; do
  # Branch deletion push; nothing to validate.
  if [[ "$local_sha" == "$zero_sha" ]]; then
    continue
  fi

  if [[ "$remote_sha" == "$zero_sha" ]]; then
    git rev-list --objects "$local_sha" >>"$tmp_objects"
  else
    git rev-list --objects "${remote_sha}..${local_sha}" >>"$tmp_objects"
  fi
done <"$tmp_refs"

if [[ ! -s "$tmp_objects" ]]; then
  exit 0
fi

sort -u "$tmp_objects" >"${tmp_objects}.uniq"

violations=0
declare -a messages=()

while read -r oid path; do
  [[ -z "${path:-}" ]] && continue

  if [[ "$path" =~ $blocked_pattern ]]; then
    messages+=("blocked path: $path")
    violations=1
    continue
  fi

  obj_type="$(git cat-file -t "$oid" 2>/dev/null || true)"
  [[ "$obj_type" != "blob" ]] && continue

  obj_size="$(git cat-file -s "$oid" 2>/dev/null || echo 0)"
  if (( obj_size > max_size_bytes )); then
    size_mb="$(awk "BEGIN { printf \"%.2f\", $obj_size / 1024 / 1024 }")"
    messages+=("large file: ${path} (${size_mb} MiB > ${max_size_mb} MiB limit)")
    violations=1
  fi
done <"${tmp_objects}.uniq"

if (( violations )); then
  echo "pre-push check failed:"
  for m in "${messages[@]}"; do
    echo "  - $m"
  done
  echo
  echo "Fix:"
  echo "  1) remove generated/local files from git history"
  echo "  2) keep them ignored via .gitignore"
  echo "  3) use Git LFS for truly large assets when needed"
  echo
  echo "Tip: override size threshold with MAX_PUSH_FILE_MB, e.g."
  echo "  MAX_PUSH_FILE_MB=75 git push"
  exit 1
fi

