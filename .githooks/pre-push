#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if ! bash scripts/update-gitignore.sh --check >/dev/null 2>&1; then
  echo "pre-push check failed: managed .gitignore files are out of date."
  echo "Run: bash scripts/update-gitignore.sh --write"
  echo "Then commit the .gitignore updates and push again."
  exit 1
fi

max_size_mb="${MAX_PUSH_FILE_MB:-50}"
max_size_bytes=$((max_size_mb * 1024 * 1024))

# Block generated/cached files and local-only artifacts.
blocked_pattern='(^|/)\.next/|(^|/)\.npm-cache/|(^|/)node_modules/|(^|/)\.DS_Store$|\.tsbuildinfo$|(^|/).*\.pem$|(^|/).*\.key$|(^|/).*\.p12$|(^|/).*\.pfx$|(^|/).*\.jks$|(^|/)id_rsa$|(^|/)id_dsa$'

tmp_refs="$(mktemp)"
tmp_objects="$(mktemp)"
trap 'rm -f "$tmp_refs" "$tmp_objects" "${tmp_objects}.uniq" "${tmp_objects}.check"' EXIT

cat >"$tmp_refs"

if [[ ! -s "$tmp_refs" ]]; then
  exit 0
fi

zero_sha="0000000000000000000000000000000000000000"

while read -r local_ref local_sha remote_ref remote_sha; do
  # Branch deletion push; nothing to validate.
  if [[ "$local_sha" == "$zero_sha" ]]; then
    continue
  fi

  if [[ "$remote_sha" == "$zero_sha" ]]; then
    # New branch: only enumerate objects no remote already has. Without the
    # negation this walks the full history (20k+ objects) on every new branch.
    git rev-list --objects "$local_sha" --not --remotes >>"$tmp_objects"
  else
    git rev-list --objects "${remote_sha}..${local_sha}" >>"$tmp_objects"
  fi
done <"$tmp_refs"

if [[ ! -s "$tmp_objects" ]]; then
  exit 0
fi

sort -u "$tmp_objects" >"${tmp_objects}.uniq"

# One batched cat-file resolves type+size for every object; the previous
# per-object `git cat-file -t` / `-s` spawned two processes per object,
# which took >10 minutes for a full-history object list on macOS.
git cat-file --batch-check='%(objecttype) %(objectsize) %(rest)' \
  <"${tmp_objects}.uniq" >"${tmp_objects}.check"

violations=0
declare -a messages=()

while read -r obj_type obj_size path; do
  # Commits have no path; unknown oids print "<oid> missing" (empty path).
  [[ -z "${path:-}" ]] && continue

  if [[ "$path" =~ (^|/)\.env($|\.) ]] && [[ ! "$path" =~ \.env(\..*)?\.example$ ]]; then
    messages+=("blocked secret-like env file: $path")
    violations=1
    continue
  fi

  if [[ "$path" =~ $blocked_pattern ]]; then
    messages+=("blocked path: $path")
    violations=1
    continue
  fi

  [[ "$obj_type" != "blob" ]] && continue

  if (( obj_size > max_size_bytes )); then
    size_mb="$(awk "BEGIN { printf \"%.2f\", $obj_size / 1024 / 1024 }")"
    messages+=("large file: ${path} (${size_mb} MiB > ${max_size_mb} MiB limit)")
    violations=1
  fi
done <"${tmp_objects}.check"

if (( violations )); then
  echo "pre-push check failed:"
  for m in "${messages[@]}"; do
    echo "  - $m"
  done
  echo
  echo "Fix:"
  echo "  1) remove generated/local files from git history"
  echo "  2) keep them ignored via .gitignore"
  echo "  3) use Git LFS for truly large assets when needed"
  echo
  echo "Tip: override size threshold with MAX_PUSH_FILE_MB, e.g."
  echo "  MAX_PUSH_FILE_MB=75 git push"
  exit 1
fi
