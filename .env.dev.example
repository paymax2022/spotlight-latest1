# Dev-container config — FAKES ONLY. Copy to .env.dev (gitignored). NEVER put
# sandbox/live secrets here or in chat (ENVIRONMENT-AND-GOLIVE.md §6). Real secrets
# come from the secret manager at deploy time.

# Service stack (compose hostnames)
DATABASE_URL=postgres://paymax:paymax@db:5432/paymax?sslmode=disable
REDIS_URL=redis://redis:6379/0
PORT=8080

# Rails mode: fake (dev/CI) | sandbox (staging) | live (prod). Dev = fake.
RAILS_MODE=fake

# FAKE rail endpoints (the compose `fakes` service on :9100) + shared dev secret.
# Identical shapes to the provider sandboxes — only the base URL/secret change.
BNPL_BASE_URL=http://fakes:9100/bnpl
BNPL_API_KEY=dev-fake
BNPL_WEBHOOK_SECRET=dev-fake-secret
PAYOUT_BASE_URL=http://fakes:9100/payout
PAYOUT_API_KEY=dev-fake
PAYOUT_WEBHOOK_SECRET=dev-fake-secret
DISBURSE_BASE_URL=http://fakes:9100/disburse
DISBURSE_API_KEY=dev-fake
DISBURSE_WEBHOOK_SECRET=dev-fake-secret
BILLING_BASE_URL=http://fakes:9100/billing
BILLING_API_KEY=dev-fake
BILLING_WEBHOOK_SECRET=dev-fake-secret

# Academy module flags (enable the surfaces you're working on; default off in prod).
FEATURE_ACADEMY_ENABLED=true
FEATURE_ACADEMY_EXAM_ENABLED=true
FEATURE_ACADEMY_SPINE_ENABLED=true
FEATURE_ACADEMY_EDUPAY_ENABLED=true
FEATURE_ACADEMY_CREDENTIALS_ENABLED=true
FEATURE_ACADEMY_LIVE_ENABLED=true
FEATURE_ACADEMY_SCHOOLS_ENABLED=true
FEATURE_ACADEMY_TUTOR_ENABLED=true
FEATURE_P2P_MARKET_ENABLED=false
FEATURE_CRYPTO_ENABLED=false

# RTC (live classes) — leave blank in dev ⇒ deterministic stub token.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Restaurant live-order WebSocket ticket signing (shared with frontend-web)
WS_TICKET_SIGNING_SECRET=dev-ws-ticket-secret-change-me
